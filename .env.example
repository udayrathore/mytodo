# Neon pooled connection for runtime. Never put credentials in NEXT_PUBLIC variables.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Neon direct connection for migrations. Use a separate Neon branch for development.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require"
APP_URL="http://localhost:3000"
OWNER_EMAIL="you@example.com"
OWNER_NAME="Your name"
APP_TIMEZONE="Asia/Kolkata"
# Generate using npm run auth:password; paste the resulting scrypt hash.
OWNER_PASSWORD_HASH="REPLACE_WITH_GENERATED_SCRYPT_HASH"

# Optional Web Push. Generate one matching VAPID pair; keep it stable across deploys.
# These values are server settings. Never use NEXT_PUBLIC for private keys/secrets.
PUSH_VAPID_PUBLIC_KEY=""
PUSH_VAPID_PRIVATE_KEY=""
PUSH_CONTACT="mailto:you@example.com"
# Random bearer secret, at least 32 characters, for /api/cron/daily-summary.
CRON_SECRET=""
# Accept new summaries during this many minutes after local 09:00 and 20:00.
# 60 accommodates Vercel Hobby's hourly scheduling window; runtime default is 15.
PUSH_SCHEDULE_WINDOW_MINUTES="60"
